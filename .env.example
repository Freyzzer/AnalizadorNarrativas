# ==========================
# AnalizadorNarrativas - Backend
# Variables de entorno (producción)
# ==========================

# Base de datos. Con esta variable el backend usa Postgres (ej: Neon).
# Sin ella, usa SQLite local (narrativa.db) — ideal para desarrollo.
DATABASE_URL=postgresql://usuario:password@host:5432/nombredb?sslmode=require

# Clave de la API de Gemini (para el chat y el análisis de capítulos).
GEMINI_API_KEY=

# ID de cliente OAuth de Google (debe ser el MISMO valor que NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend).
GOOGLE_CLIENT_ID=

# Secreto para firmar el JWT de sesión. Genera uno largo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Orígenes permitidos por CORS (separados por coma). En Vercel con rewrites,
# todo sale del mismo origen y la cookie no se envía al backend directo;
# deja los orígenes de desarrollo si haces pruebas locales.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://TU-FRONTEND.vercel.app

# Cookie de sesión. En producción siempre en true (requiere HTTPS).
COOKIE_SECURE=true

# SameSite de la cookie: con los rewrites de Vercel queda todo en el mismo origen, así que 'lax' basta.
COOKIE_SAMESITE=lax

# Limpieza de datos de invitados.
GUEST_TTL_DIAS=7
GUEST_PURGE_INTERVAL_HORAS=6
